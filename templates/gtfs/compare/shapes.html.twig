{% extends 'base.html.twig' %}

{% block title %}{{ 'compare.title'|trans({}, 'gtfs_compare') }}{% endblock %}

{% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/main.css') }}" />
{% endblock %}

{% block body %}
{% set lang = app.request.query.get('lang') %}
        <main id="main" class="results">

            <h2 id="compare-shapes">{{ 'compare.shapes.title'|trans({}, 'gtfs_compare') }}{% if same_feed %} - {{ p.feed }}{% endif %}</h2>
            <div class="indent">

{% if not left_found %}
                <p>{{ 'compare.invalid_input'|trans({}, 'gtfs_compare') }}: 'feed' = '{{ p.feed }}' + 'release_date' = '{{ p.releaseDate }}'</p>
{% endif %}
{% if not right_found and not (same_feed and p.releaseDate == p.releaseDate2) %}
                <p>{{ 'compare.invalid_input'|trans({}, 'gtfs_compare') }}: 'feed2' = '{{ p.feed2 }}' + 'release_date2' = '{{ p.releaseDate2 }}'</p>
{% endif %}
            </div>

        </main> <!-- main -->
{% endblock %}
