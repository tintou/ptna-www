<!DOCTYPE html>
<html lang="{{ app.request.locale }}" dir="{{ app.request.locale in rtl_locales ? 'rtl' : 'ltr' }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <meta name="keywords" content="OSM Public Transport PTv2">
        <meta name="description" content="PTNA - Public Transport Network Analysis">
        <meta name="robots" content="noindex,nofollow">
        <link rel="shortcut icon" href="/favicon.ico">
        <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32">
        <link rel="icon" type="image/png" href="/favicon.png" sizes="96x96">
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any">
        <link rel="stylesheet" href="{{ asset('vendor/bootstrap/dist/css/bootstrap.min.css') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
      <div id="wrapper" class="container-fluid px-3">
        <header id="headerblock">
            <nav class="navbar navbar-expand-lg bg-body-tertiary rounded mt-2 mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand d-flex align-items-center gap-3" href="{{ path('app_home') }}">
                        <img src="/img/logo.svg" alt="logo" width="64" height="64" />
                        <span>
                            <span class="d-block fs-4 fw-bold">PTNA - Public Transport Network Analysis</span>
                            <span class="d-block fs-6 fw-semibold text-body-secondary">{{ 'header.subtitle'|trans }}</span>
                        </span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#headernav" aria-controls="headernav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse justify-content-end" id="headernav">
                        {% set lang = app.request.query.get('lang') in enabled_locales ? app.request.query.get('lang') : null %}
                        <ul class="navbar-nav align-items-lg-center">
                            <li class="nav-item"><a class="nav-link{{ app.current_route == 'app_home' ? ' active' }}" href="{{ path('app_home', {lang: lang}) }}">{{ 'nav.home'|trans }}</a></li>
                            <li class="nav-item"><a class="nav-link{{ app.current_route == 'app_contact' ? ' active' }}" href="{{ path('app_contact', {lang: lang}) }}">{{ 'nav.contact'|trans }}</a></li>
                            <li class="nav-item"><a class="nav-link" target="_blank" href="https://www.openstreetmap.de/impressum.html">{{ 'nav.imprint'|trans }}</a></li>
                            <li class="nav-item"><a class="nav-link" target="_blank" href="https://www.fossgis.de/datenschutzerklärung">{{ 'nav.privacy'|trans }}</a></li>
                            <li class="nav-item d-flex gap-2 ms-lg-2">
                                <a href="{{ path(app.current_route, app.current_route_parameters|merge({lang: 'en'})) }}" title="english"><img src="/img/flags/GB.svg" class="flagimg" alt="{{ 'flag'|trans({}, null, 'en') }}" /></a>
                                <a href="{{ path(app.current_route, app.current_route_parameters|merge({lang: 'de'})) }}" title="deutsch"><img src="/img/flags/DE.svg" class="flagimg" alt="{{ 'flag'|trans({}, null, 'de') }}" /></a>
                                <a href="{{ path(app.current_route, app.current_route_parameters|merge({lang: 'fr'})) }}" title="français"><img src="/img/flags/FR.svg" class="flagimg" alt="{{ 'flag'|trans({}, null, 'fr') }}" /></a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        {% block body %}{% endblock %}

        <footer id="footer" class="clearing border-top mt-4 pt-3 text-body-secondary small">
            <p>
                {{ 'footer.data'|trans({}, 'footer')|raw }}
            </p>
            <p>
                {{ 'footer.license'|trans({}, 'footer')|raw }}
            </p>
            <p>
                {{ 'footer.overpass'|trans({}, 'footer')|raw }}
            </p>
            {% set footer_translation = 'footer.translation'|trans({}, 'footer') %}
            {% if footer_translation != 'footer.translation' %}
            <p>
                {{ footer_translation|raw }}
            </p>
            {% endif %}
        </footer>
      </div> <!-- wrapper -->
    </body>
</html>
