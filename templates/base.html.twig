<!DOCTYPE html>
<html lang="{{ app.request.locale }}" dir="{{ app.request.locale in rtl_locales ? 'rtl' : 'ltr' }}">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <meta name="keywords" content="OSM Public Transport PTv2">
        <meta name="description" content="PTNA - Public Transport Network Analysis">
        <meta name="robots" content="noindex,nofollow">
        <link rel="shortcut icon" href="/favicon.ico">
        <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32">
        <link rel="icon" type="image/png" href="/favicon.png" sizes="96x96">
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
      <div id="wrapper">
        <header id="headerblock">
            <div id="headerimg" class="logo">
                <a href="{{ path('app_home') }}"><img src="/img/logo.png" alt="logo" /></a>
            </div>
            <div id="headertext">
                <h1><a href="{{ path('app_home') }}">PTNA - Public Transport Network Analysis</a></h1>
                <h2>{{ 'header.subtitle'|trans }}</h2>
            </div>
            <div id="headernav">
                {% set lang = app.request.query.get('lang') in enabled_locales ? app.request.query.get('lang') : null %}
                {% if app.current_route == 'app_home' %}{{ 'nav.home'|trans }}{% else %}<a href="{{ path('app_home', {lang: lang}) }}">{{ 'nav.home'|trans }}</a>{% endif %} |
                {% if app.current_route == 'app_contact' %}{{ 'nav.contact'|trans }}{% else %}<a href="{{ path('app_contact', {lang: lang}) }}">{{ 'nav.contact'|trans }}</a>{% endif %} |
                <a target="_blank" href="https://www.openstreetmap.de/impressum.html">{{ 'nav.imprint'|trans }}</a> |
                <a target="_blank" href="https://www.fossgis.de/datenschutzerklärung">{{ 'nav.privacy'|trans }}</a> |
                <a href="{{ path(app.current_route, app.current_route_parameters|merge({lang: 'en'})) }}" title="english"><img src="/img/GreatBritain16.png"  class="flagimg" alt="{{ 'flag'|trans({}, null, 'en') }}" /></a>
                <a href="{{ path(app.current_route, app.current_route_parameters|merge({lang: 'de'})) }}" title="deutsch"><img src="/img/Germany16.png"  class="flagimg" alt="{{ 'flag'|trans({}, null, 'de') }}" /></a>
                <a href="{{ path(app.current_route, app.current_route_parameters|merge({lang: 'fr'})) }}" title="français"><img src="/img/France16.png"  class="flagimg" alt="{{ 'flag'|trans({}, null, 'fr') }}" /></a>
            </div>
        </header>

        {% block body %}{% endblock %}

        <hr />

        <footer id="footer">
            <p>
                {{ 'footer.data'|trans({}, 'footer')|raw }}
            </p>
            <p>
                {{ 'footer.license'|trans({}, 'footer')|raw }}
            </p>
            <p>
                {{ 'footer.overpass'|trans({}, 'footer')|raw }}
            </p>
            {% set footer_translation = 'footer.translation'|trans({}, 'footer') %}
            {% if footer_translation != 'footer.translation' %}
            <p>
                {{ footer_translation|raw }}
            </p>
            {% endif %}
        </footer>
      </div> <!-- wrapper -->
    </body>
</html>
