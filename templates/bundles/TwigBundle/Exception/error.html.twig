{% extends 'base.html.twig' %}

{% set is_not_found = status_code == 404 %}

{% block title %}PTNA - {{ is_not_found ? 'error.not_found.title'|trans : 'error.generic.title'|trans }}{% endblock %}

{% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/main.css') }}" />
{% endblock %}

{% block body %}
        <main id="main" class="text-center py-5">
            <p class="display-1 fw-bold text-body-secondary mb-0">{{ status_code }}</p>
            <h2 class="mb-3">{{ is_not_found ? 'error.not_found.title'|trans : 'error.generic.title'|trans }}</h2>
            <p class="lead text-body-secondary">{{ is_not_found ? 'error.not_found.text'|trans : 'error.generic.text'|trans }}</p>
            <div class="d-flex justify-content-center gap-2 mt-4">
                <a class="btn btn-primary" href="{{ path('app_home') }}">{{ 'error.home'|trans }}</a>
                <a class="btn btn-outline-secondary" href="{{ path('app_results') }}">{{ 'error.results'|trans }}</a>
            </div>
        </main>
{% endblock %}
